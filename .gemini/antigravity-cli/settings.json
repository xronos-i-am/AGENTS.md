{
  "agentMode": "accept-edits",
  "altScreenMode": "always",
  "model": "Gemini 4 Hydrogen (High)",
  "permissions": {
    "allow": [
      "command(grep)",
      "command(cat)",
      "command(ls)",
      "command(apm)",
      "command(head)",
      "command(agy)",
      "command(which)",
      "command(strings)",
      "command(ln)",
      "command(diff)",
      "command(echo)",
      "command(tail)",
      "command(ps)",
      "command(wc)",
      "command(printf)",
      "command(mise)",
      "command(make)",
      "command(wt)",
      "command(git)",
      "command(find)",
      "command(jq)",
      "command(file)",
      "command(glab)",
      "command(agent-diff)",
      "command(python3)",
      "command(regex:(python3\\s+|bash\\s+)?(\\./)?(.*\\/)?(agent-diff|\\.apm|apm_modules)/.*)",
      "command(gh)",
      "command(pytest)",
      "command(lefthook)",
      "command(regex:^rm(\\s+-[a-zA-Z]+)*\\s+/tmp/.*)",
      "command(sort)",
      "command(sqlite3)",
      "command(.agents/skills/task/land.sh)",
      "command(readlink)",
      "command(ping)",
      "command(ip)",
      "command(rg)",
      "command(.agents/skills/ptask-api/scripts/get_task.sh)",
      "command(.agents/skills/tracer-api/scripts/fetch.sh)",
      "command(.agents/skills/ptask-api/scripts/post_comment.sh)",
      "command(pwd)",
      "command(sleep)",
      "command(biome)",
      "command(.agents/skills/ptask-api/scripts/me.sh)",
      "command(.agents/skills/ptask-api/scripts/create_task.sh)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.gemini/statusline-agy.sh"
  }
}

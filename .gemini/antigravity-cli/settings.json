{
  "allowNonWorkspaceAccess": true,
  "altScreenMode": "always",
  "model": "Claude Sonnet 5.5 (Low)",
  "permissions": {
    "allow": [
      "command(apm)",
      "command(regex:^(python3\\s+|bash\\s+|sh\\s+)?([^\\s;&|]+/)?(agent-diff|\\.apm|apm_modules|\\.agents/skills|agent-kit/skills)/[^\\s;&|]+(\\s+.*)?$)",
      "command(wt)",
      "command(make setup)",
      "command(make release)",
      "command(ls)",
      "command(make test)",
      "command(git add)"
    ]
  },
  "showTips": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.gemini/statusline-agy.sh"
  }
}

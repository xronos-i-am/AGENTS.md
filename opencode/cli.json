{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "plugins": [
    {
      "package": "/home/dev/.config/opencode/plugins/status-line"
    }
  ],
  "animations": true,
  "theme": {
    "name": "tokyonight"
  },
  "keybinds": {
    "input.buffer.home": "home",
    "input.buffer.end": "end",
    "session.first": "ctrl+home",
    "session.last": "ctrl+end"
  }
}
